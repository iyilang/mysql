# crystal-mysql's spec/db_spec.cr: crystal-db's shared driver specs
# (`DriverSpecs`) run against MySQL, and the driver's own examples.
#
# A `UUID` is not a `DBValue`, so the UUID samples are `UUIDValue`s, read
# back with `read(UUIDValue)`. `NotSupportedType`, which crystal-mysql
# bound to see it refused, is a `CustomValue` here: anything else is
# refused at compile time.
module mysql/driver_specs_test

import std/int
import std/float
import std/time::{Time, Span, Location}
import std/uuid::{UUID}
import std/slice::{Slice, Bytes}
import db
import db/db/errors::*
import db/db/value::{CustomValue}
import db/db/spec::{DriverSpecs, expect_error}
import mysql/core
import mysql/types::{UUIDValue}
import mysql/testing/spec_helper::{db_url, run_sql, mysql_version}

class NotSupportedType < CustomValue
  def to_s : String
    "NotSupportedType"
  end
end

def null_text(null : Bool) : String
  null ? "NULL" : "NOT NULL"
end

# *values*, repeated *times*.
def bytes(values : Array(Int32), times : Int32 = 1) : Bytes
  slice = Bytes.new(values.size * times)
  slice.size.times { |i| slice[i] = values[i % values.size].to_u8 }
  slice
end

def hex(values : Array(Int32)) : String
  values.map { |v| v.to_s(16).rjust(2, '0').upcase }.join
end

def microseconds? : Bool
  version = {0, 0, 0}
  ::Db.open(db_url) { |db| version = mysql_version(db) }.or_panic
  version[0] > 5 || (version[0] == 5 && version[1] >= 7)
end

UUID_TEXT = "87b3042b-9b9a-41b7-8b15-a93d3f17025e"

DriverSpecs.run do |specs|
  specs.before do
    run_sql("DROP DATABASE IF EXISTS crystal_mysql_test", "CREATE DATABASE crystal_mysql_test")
  end
  specs.after do
    run_sql("DROP DATABASE IF EXISTS crystal_mysql_test")
  end

  specs.connection_string db_url("crystal_mysql_test")

  specs.sample_value true, "bool", "true", type_safe_value: false
  specs.sample_value false, "bool", "false", type_safe_value: false
  specs.sample_value 5_i8, "tinyint(1)", "5", type_safe_value: false
  specs.sample_value 54_i16, "smallint(2)", "54", type_safe_value: false
  specs.sample_value 123, "mediumint(2)", "123", type_safe_value: false
  specs.sample_value 1, "int", "1", type_safe_value: false
  specs.sample_value 1_i64, "bigint", "1"
  specs.sample_value -5_i8, "tinyint(1)", "-5", type_safe_value: false
  specs.sample_value -54_i16, "smallint(2)", "-54", type_safe_value: false
  specs.sample_value -123, "mediumint(2)", "-123", type_safe_value: false
  specs.sample_value -1, "int", "-1", type_safe_value: false
  specs.sample_value -1_i64, "bigint", "-1"
  specs.sample_value "hello", "varchar(25)", "'hello'"
  specs.sample_value 1.5_f32, "float", "1.5", type_safe_value: false
  specs.sample_value 1.5, "double", "1.5"
  specs.sample_value Time.utc(2016, 2, 15), "datetime", "TIMESTAMP '2016-02-15 00:00:00.000'"
  specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30), "datetime", "TIMESTAMP '2016-02-15 10:15:30.000'"
  specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30), "timestamp", "TIMESTAMP '2016-02-15 10:15:30.000'"
  specs.sample_value Time.local(2016, 2, 15, 7, 15, 30, location: Location.fixed("fixed", -3 * 3600)), "timestamp", "'2016-02-15 10:15:30.000'", type_safe_value: false
  specs.sample_value Time.utc(2016, 2, 29), "date", "LAST_DAY('2016-02-15')", type_safe_value: false
  specs.sample_value Span.new(nanoseconds: 0_i64), "Time", "TIME('00:00:00')"
  specs.sample_value Span.new(hours: 10_i64, minutes: 25_i64, seconds: 21_i64), "Time", "TIME('10:25:21')"
  specs.sample_value Span.new(days: 0_i64, hours: 0_i64, minutes: 10_i64, seconds: 5_i64, nanoseconds: 0_i64), "Time", "TIME('00:10:05.000')"
  specs.sample_value UUIDValue.new(UUID.parse(UUID_TEXT)), "BLOB", "X'87b3042b9b9a41b78b15a93d3f17025e'", type_safe_value: false
  specs.sample_value UUIDValue.new(UUID.parse(UUID_TEXT)), "binary(16)", %(UNHEX(REPLACE("#{UUID_TEXT}", "-",""))), type_safe_value: false

  # needs to check version, microsecond support >= 5.7
  if microseconds?
    specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30, nanosecond: 543_000_000), "datetime(3)", "TIMESTAMP '2016-02-15 10:15:30.543'"
    specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30, nanosecond: 543_012_000), "datetime(6)", "TIMESTAMP '2016-02-15 10:15:30.543012'"
    specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30, nanosecond: 543_000_000), "timestamp(3)", "TIMESTAMP '2016-02-15 10:15:30.543'"
    specs.sample_value Time.utc(2016, 2, 15, 10, 15, 30, nanosecond: 543_012_000), "timestamp(6)", "TIMESTAMP '2016-02-15 10:15:30.543012'"
    specs.sample_value Span.new(days: 0_i64, hours: 10_i64, minutes: 15_i64, seconds: 30_i64, nanoseconds: 543_000_000_i64), "Time(3)", "TIME '10:15:30.543'"
    specs.sample_value Span.new(days: 0_i64, hours: 10_i64, minutes: 15_i64, seconds: 30_i64, nanoseconds: 543_012_000_i64), "Time(6)", "TIME '10:15:30.543012'"
  end

  ary = [0x41, 0x5A, 0x61, 0x7A]
  specs.sample_value bytes(ary), "BLOB", "X'415A617A'", type_safe_value: false

  [
    {"TINYBLOB", 10},
    {"BLOB", 1000},
    {"MEDIUMBLOB", 10000},
    {"LONGBLOB", 100000},
  ].each do |type_and_size|
    type, size = type_and_size
    specs.sample_value bytes(ary, size), type, "X'#{hex(ary) * size}'", type_safe_value: false
  end

  [
    {"TINYTEXT", 10},
    {"TEXT", 1000},
    {"MEDIUMTEXT", 10000},
    {"LONGTEXT", 100000},
  ].each do |type_and_size|
    type, size = type_and_size
    value = "Ham Sandwich" * size
    specs.sample_value value, type, "'#{value}'"
  end

  specs.binding_syntax do |index|
    "?"
  end

  specs.create_table_1column_syntax do |table_name, col1|
    "create table #{table_name} (#{col1.name} #{col1.sql_type} #{null_text(col1.null)})"
  end

  specs.create_table_2columns_syntax do |table_name, col1, col2|
    "create table #{table_name} (#{col1.name} #{col1.sql_type} #{null_text(col1.null)}, #{col2.name} #{col2.sql_type} #{null_text(col2.null)})"
  end

  specs.select_1column_syntax do |table_name, col1|
    "select #{col1.name} from #{table_name}"
  end

  specs.select_2columns_syntax do |table_name, col1, col2|
    "select #{col1.name}, #{col2.name} from #{table_name}"
  end

  specs.select_count_syntax do |table_name|
    "select count(*) from #{table_name}"
  end

  specs.select_scalar_syntax do |expression, sql_type|
    "select #{expression}"
  end

  specs.insert_1column_syntax do |table_name, col, expression|
    "insert into #{table_name} (#{col.name}) values (#{expression})"
  end

  specs.insert_2columns_syntax do |table_name, col1, expr1, col2, expr2|
    "insert into #{table_name} (#{col1.name}, #{col2.name}) values (#{expr1}, #{expr2})"
  end

  specs.drop_table_if_exists_syntax do |table_name|
    "drop table if exists #{table_name}"
  end

  specs.it "gets last insert row id", prepared: :both do |db|
    db.exec("create table person (id int not null primary key auto_increment, name varchar(25), age int)").or_panic
    db.exec(%(insert into person (name, age) values ("foo", 10))).or_panic
    res = db.exec(%(insert into person (name, age) values ("foo", 10))).or_panic
    assert res.last_insert_id == 2
    assert res.rows_affected == 1
  end

  specs.it "get timestamp from table" do |db|
    db.exec("create table table1 (m int, dt datetime, ts timestamp DEFAULT CURRENT_TIMESTAMP)").or_panic
    db.exec("insert into table1 (m, dt) values(?, NOW())", 1).or_panic

    dt, ts = db.query_one("SELECT dt, ts from table1", as: Tuple(Time, Time)).or_panic
    assert (ts - dt).total_seconds.abs <= 0.5
  end

  specs.it "raises on unsupported param types" do |db|
    expect_error(db.query("select ?", NotSupportedType.new), DBError, "MySql::Type does not support", partial: true)
    # the connection went back to the pool: another statement runs
    assert db.scalar("select 1").or_panic == 1
  end

  specs.it "ensures statements are closed" do |db|
    db.exec(%(create table if not exists a (i int not null, str text not null);)).or_panic
    db.exec(%(insert into a (i, str) values (23, "bai bai");)).or_panic

    2.times do
      ::Db.open(specs.connection_string) do |db|
        db.query("SELECT i, str FROM a WHERE i = ?", 23) do |rs|
          # left with its row unread
          rs.move_next.or_panic
          nil
        end.or_panic

        db.exec("UPDATE a SET i = ? WHERE i = ?", 23, 23).or_panic
      end.or_panic
    end
  end

  specs.it "does not close a connection before cleaning up the result set" do |db|
    ::Db.open(specs.connection_string) do |db|
      db.query("select 'foo'") do |rs|
        rs.each do
          rs.read(String).or_panic
        end.or_panic
        db.query("select 'bar'") do |rs|
          rs.each do
            rs.read(String).or_panic
          end.or_panic
        end.or_panic
      end.or_panic
    end.or_panic
  end

  specs.it "does not close a connection before cleaning up the text result set" do |db|
    ::Db.open(specs.connection_string) do |db|
      db.unprepared.query("select 'foo'") do |rs|
        rs.each do
          rs.read(String).or_panic
        end.or_panic
        db.unprepared.query("select 'bar'") do |rs|
          rs.each do
            rs.read(String).or_panic
          end.or_panic
        end.or_panic
      end.or_panic
    end.or_panic
  end

  specs.it "allows unprepared statement queries" do |db|
    db.exec(%(create table if not exists a (i int not null, str text not null);)).or_panic
    db.exec(%(insert into a (i, str) values (23, "bai bai");)).or_panic

    2.times do
      ::Db.open(specs.connection_string) do |db|
        db.unprepared.query("SELECT i, str FROM a WHERE i = 23") do |rs|
          rs.each do
            assert rs.read(Int32).or_panic == 23
            assert rs.read(String).or_panic == "bai bai"
          end.or_panic
        end.or_panic
      end.or_panic
    end
  end

  specs.it "should convert an EXISTS result to a Bool" do |db|
    db.exec("create table data (id int not null primary key auto_increment, name varchar(25));").or_panic
    db.exec(%(insert into data (name) values ("foo");)).or_panic

    assert db.query_one("SELECT EXISTS(SELECT 1 FROM data WHERE id = ?);", 1, as: Bool).or_panic == true
    assert db.query_one("SELECT EXISTS(SELECT 1 FROM data WHERE id = ?);", 2, as: Bool).or_panic == false
  end

  specs.it "should raise when reading UUID from text columns" do |db|
    db.exec("create table data (id int not null primary key auto_increment, uuid_text varchar(36));").or_panic
    db.exec(%(insert into data (uuid_text) values ("#{UUID_TEXT}");)).or_panic

    message = "The column uuid_text of type MySql::Type::VarString returns a String and can't be read as UUID"
    expect_error(db.prepared.query_one("SELECT uuid_text FROM data", as: UUID), DBError, message)
    expect_error(db.unprepared.query_one("SELECT uuid_text FROM data", as: UUID), DBError, message)
  end

  specs.it "should raise when reading UUID from binary columns with invalid length" do |db|
    db.exec("create table data (id int not null primary key auto_increment, uuid_blob blob);").or_panic
    db.exec(%(insert into data (uuid_blob) values (X'415A617A');)).or_panic

    expect_error(db.prepared.query_one("SELECT uuid_blob FROM data", as: UUID), ArgumentError, "Invalid bytes length 4, expected 16")
    expect_error(db.unprepared.query_one("SELECT uuid_blob FROM data", as: UUID), ArgumentError, "Invalid bytes length 4, expected 16")
  end

  specs.it "reads a UUID from a binary column" do |db|
    db.exec("create table data (uuid_bin binary(16))").or_panic
    db.exec("insert into data (uuid_bin) values (?)", UUIDValue.new(UUID.parse(UUID_TEXT))).or_panic

    assert db.prepared.query_one("SELECT uuid_bin FROM data", as: UUID).or_panic.to_s == UUID_TEXT
    assert db.unprepared.query_one("SELECT uuid_bin FROM data", as: UUID).or_panic.to_s == UUID_TEXT
  end
end
